---
import Arcs from './Arcs.astro';
import Icon from './Icon.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const year = new Date().getFullYear();
---

<footer class="footer" data-nav="light">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <a class="brand" href="/" aria-label={`${site.name}, home`}>
        <img src="/img/logo-mark.png" alt="" width="183" height="192" loading="lazy" />
        <span>{site.name}</span>
      </a>
      <p>{site.positioning}</p>
    </div>

    <nav aria-label="Footer">
      <p class="footer__label">Explore</p>
      <ul role="list">
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <p class="footer__label">Contact</p>
      <ul role="list">
        <li>
          <a class="footer__icon-link" href={`mailto:${site.contactEmail}`}>
            <Icon name="mail" size={22} />
            {site.contactEmail}
          </a>
        </li>
        {
          site.linkedinUrl && (
            <li>
              <a class="footer__icon-link" href={site.linkedinUrl} rel="noopener">
                <Icon name="brand-linkedin" size={22} />
                LinkedIn
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="wrap footer__base small">
    <p>© {year} {site.name}</p>
    <p>{site.disclaimer}</p>
  </div>

  <div class="footer__end" aria-hidden="true">
    <Arcs class="footer__arcs" />
    <p class="footer__word">{site.name}</p>
  </div>
</footer>

<style>
  .footer {
    padding-top: 72px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 48px clamp(48px, 8vw, 120px);
  }

  /* The wordmark repeats the logo, which is set in Outfit SemiBold. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .brand img {
    width: auto;
    height: 48px;
  }

  .footer__brand p {
    max-width: 24ch;
    margin-top: 20px;
  }

  .footer__label {
    margin-bottom: 12px;
    color: var(--ink);
    font-weight: var(--fw-medium);
  }

  .footer ul {
    display: grid;
    gap: 2px;
  }

  /* 44px minimum pointer target */
  .footer li a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .footer li a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer__icon-link {
    gap: 10px;
    white-space: nowrap;
  }

  /* Closing band: arcs with a faint oversized wordmark rising out of them. */
  .footer__end {
    position: relative;
    height: clamp(120px, 19vw, 280px);
    overflow: hidden;
  }

  .footer__end :global(.footer__arcs) {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 100%;
  }

  .footer__word {
    position: absolute;
    bottom: -0.18em;
    left: 50%;
    margin: 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: clamp(64px, 15.5vw, 250px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
    transform: translateX(-50%);
    pointer-events: none;
    user-select: none;
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 32px;
    margin-top: 56px;
    padding-block: 24px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 1023px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 599px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .footer__icon-link {
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }
</style>
