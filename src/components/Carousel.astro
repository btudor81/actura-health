---
// Horizontal card row. Without JS it is a plain scrollable list with a native
// scrollbar; with JS it gains arrows and a row of dashes (CarouselBar).
// The parent passes the <li> slides and sets their width.
//   bleed: the row runs past the wrap to both viewport edges, so the next card shows.
import CarouselBar from './CarouselBar.astro';

interface Props {
  /** Names the scrollable region for assistive tech, e.g. "Services". */
  label: string;
  bleed?: boolean;
}

const { label, bleed = false } = Astro.props;
---

<div class:list={['carousel', { 'carousel--bleed': bleed }]} data-carousel data-label={label}>
  <div class="carousel__view" tabindex="0" role="region" aria-label={`${label}, scrollable`}>
    <ul role="list" class="carousel__track">
      <slot />
    </ul>
  </div>

  <CarouselBar label={label} class={bleed ? 'wrap' : undefined} />
</div>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const view = root.querySelector<HTMLElement>('.carousel__view');
    const track = root.querySelector<HTMLElement>('.carousel__track');
    const dots = root.querySelector<HTMLElement>('.carousel__dots');
    const buttons = root.querySelectorAll<HTMLButtonElement>('.carousel__btn');
    if (!view || !track || !dots) return;

    const label = root.dataset.label ?? 'Slide';
    const behavior = (): ScrollBehavior => (calm.matches ? 'auto' : 'smooth');
    const reach = () => view.scrollWidth - view.clientWidth;

    const step = () => {
      const slide = track.firstElementChild;
      if (!slide) return view.clientWidth;
      return slide.getBoundingClientRect().width + (parseFloat(getComputedStyle(track).columnGap) || 0);
    };

    // One dash per place the row can rest.
    const build = () => {
      const count = Math.max(1, Math.round(reach() / step()) + 1);
      root.classList.toggle('is-static', count < 2);
      if (dots.childElementCount === count) return;
      dots.replaceChildren(
        ...Array.from({ length: count }, (_, index) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'carousel__dot';
          dot.setAttribute('aria-label', `${label}: position ${index + 1} of ${count}`);
          dot.addEventListener('click', () => {
            view.scrollTo({ left: index === count - 1 ? reach() : index * step(), behavior: behavior() });
          });
          return dot;
        }),
      );
    };

    const update = () => {
      const max = reach();
      const last = dots.childElementCount - 1;
      const current = view.scrollLeft >= max - 1 ? last : Math.min(last, Math.round(view.scrollLeft / step()));
      Array.from(dots.children).forEach((dot, index) => {
        if (index === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      buttons.forEach((button) => {
        const back = button.dataset.dir === '-1';
        const end = back ? view.scrollLeft <= 1 : view.scrollLeft >= max - 1;
        button.setAttribute('aria-disabled', String(end));
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        if (button.getAttribute('aria-disabled') === 'true') return;
        view.scrollBy({ left: Number(button.dataset.dir) * step(), behavior: behavior() });
      });
    });

    view.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', () => {
      build();
      update();
    });
    build();
    update();
  });
</script>

<style>
  .carousel {
    --edge: max(var(--gutter), calc((100% - var(--maxw)) / 2));
  }

  .carousel__view {
    /* Room for card shadows and the focus ring inside the scroll box. */
    margin-block: -12px;
    padding-block: 12px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .carousel__view:focus-visible {
    outline-offset: -3px;
    border-radius: var(--r-md);
  }

  :global(html.js) .carousel__view {
    scrollbar-width: none;
  }

  :global(html.js) .carousel__view::-webkit-scrollbar {
    display: none;
  }

  .carousel__track {
    display: flex;
    gap: 20px;
  }

  .carousel__track > :global(li) {
    flex: none;
    scroll-snap-align: start;
  }

  /* Bleed: the first card lines up with the wrap, the row runs off both edges. */
  .carousel--bleed .carousel__view {
    scroll-padding-inline: var(--edge);
  }

  .carousel--bleed .carousel__track {
    width: max-content;
    padding-inline: var(--edge);
  }
</style>
