---
// Custom data visual: a sample monitoring summary drawn as a small dashboard.
// Two views of the same five indicators: what the vendor reports and what an
// independent review of the records finds. The switch is two radio inputs, so
// it works with JS off. Counts come from the sample rows, nothing is typed in.
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';

const { scorecard } = (await getHomepage()).hero;

const STATUS = {
  met: { label: 'Met', icon: 'check' },
  'not-met': { label: 'Not met', icon: 'x' },
  partial: { label: 'Partially met', icon: 'minus' },
} as const;

type StatusKey = keyof typeof STATUS;

const SEGMENTS = 17;
const total = scorecard.rows.length;

const views = (['vendor', 'review'] as const).map((key) => {
  const met = scorecard.rows.filter((row) => row[key] === 'met').length;
  return {
    key,
    ...scorecard.views[key],
    met,
    lit: Math.round((met / total) * SEGMENTS),
    icon: key === 'review' ? 'database' : 'building-hospital',
  };
});
---

<div class="summary reveal" role="group" aria-labelledby="summary-title">
  <input class="visually-hidden" type="radio" name="summary-view" id="view-vendor" />
  <input class="visually-hidden" type="radio" name="summary-view" id="view-review" checked />
  {[0, 1, 2, 3].map(() => <span class="summary__pin" aria-hidden="true" />)}

  <div class="summary__head">
    <p id="summary-title" class="summary__title">{scorecard.title}</p>
    <div class="seg">
      {views.map((view) => <label for={`view-${view.key}`}>{view.label}</label>)}
    </div>
  </div>

  <div class="summary__body">
    {
      views.map((view) => (
        <div class={`view view--${view.key}`}>
          <div class="mock source">
            <span class="tile">
              <Icon name={view.icon} size={24} />
            </span>
            <p>
              <strong>{view.source}</strong>
              <span>{view.sourceNote}</span>
            </p>
            <p class="source__status">{view.status}</p>
          </div>

          <div class="mock gauge">
            <p>
              <span>{scorecard.measure}</span>
              <strong>
                {view.met} of {total}
              </strong>
              <span>{view.caption}</span>
            </p>
            <svg viewBox="0 0 168 92" width="168" height="92" aria-hidden="true" focusable="false">
              {Array.from({ length: SEGMENTS }, (_, index) => (
                <rect
                  class:list={{ 'is-lit': index < view.lit }}
                  x="81"
                  y="8"
                  width="6"
                  height="26"
                  rx="3"
                  transform={`rotate(${-90 + (index * 180) / (SEGMENTS - 1)} 84 86)`}
                />
              ))}
            </svg>
          </div>

          <ul role="list" class="mock rows">
            {scorecard.rows.map((row) => {
              const state = row[view.key] as StatusKey;
              return (
                <li>
                  {row.indicator}
                  <span class={`status status--${state}`}>
                    <Icon name={STATUS[state].icon} size={18} stroke={2} />
                    {STATUS[state].label}
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* Shell: a pale plate with a pin in each corner, holding white cards. */
  .summary {
    position: relative;
    display: grid;
    gap: 16px;
    padding: 32px 24px 24px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, var(--tint) 0%, var(--tint-2) 100%);
    box-shadow:
      inset 0 1px 0 #ffffff,
      var(--shadow-float);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .summary__pin {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tint-3);
    box-shadow: inset 0 1px 1px rgba(20, 52, 110, 0.18);
  }

  .summary__pin:nth-of-type(1) {
    top: 12px;
    left: 12px;
  }

  .summary__pin:nth-of-type(2) {
    top: 12px;
    right: 12px;
  }

  .summary__pin:nth-of-type(3) {
    bottom: 12px;
    left: 12px;
  }

  .summary__pin:nth-of-type(4) {
    right: 12px;
    bottom: 12px;
  }

  .summary__head {
    display: grid;
    gap: 16px;
  }

  .summary__title {
    color: var(--ink);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-head);
    line-height: 1.25;
  }

  /* Segmented switch between the two views. */
  .seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 4px;
    border-radius: var(--r-sm);
    background: rgba(20, 52, 110, 0.07);
  }

  .seg label {
    display: grid;
    place-items: center;
    min-height: 44px;
    padding: 6px 10px;
    border-radius: 7px;
    color: var(--muted);
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .seg label:hover {
    color: var(--ink);
  }

  #view-vendor:checked ~ .summary__head label[for='view-vendor'],
  #view-review:checked ~ .summary__head label[for='view-review'] {
    background: var(--card);
    box-shadow: var(--shadow-tile);
    color: var(--ink);
    font-weight: var(--fw-medium);
  }

  #view-vendor:focus-visible ~ .summary__head label[for='view-vendor'],
  #view-review:focus-visible ~ .summary__head label[for='view-review'] {
    outline: 3px solid var(--navy);
    outline-offset: 2px;
  }

  #view-vendor:checked ~ .summary__body .view--review,
  #view-review:checked ~ .summary__body .view--vendor {
    display: none;
  }

  .view {
    display: grid;
    gap: 12px;
  }

  .view .mock {
    box-shadow: inset 0 1px 0 #ffffff, 0 1px 2px rgba(20, 52, 110, 0.06);
  }

  .view strong {
    display: block;
    color: var(--ink);
    font-weight: var(--fw-medium);
  }

  .view p > span {
    display: block;
    color: var(--muted);
  }

  .source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    padding: 14px 16px;
  }

  .source .tile {
    width: 44px;
    height: 44px;
  }

  .source strong {
    font-size: var(--fs-body);
    letter-spacing: var(--tracking-head);
    line-height: 1.3;
  }

  .source__status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    color: var(--ink);
  }

  .source__status::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .view--review .source__status::before {
    background: var(--gold);
  }

  .gauge {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 16px;
    padding: 18px 16px 16px 20px;
  }

  .gauge strong {
    margin-block: 4px 2px;
    font-size: var(--fs-h3);
    letter-spacing: var(--tracking-head);
    line-height: 1.2;
  }

  .gauge svg {
    flex: none;
    width: 136px;
    height: auto;
  }

  .gauge rect {
    fill: var(--tint-3);
  }

  .gauge rect.is-lit {
    fill: var(--gold);
  }

  .rows {
    padding: 2px 20px;
  }

  .rows li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 13px;
    border-top: 1px solid var(--line);
    color: var(--ink);
  }

  .rows li:first-child {
    border-top: 0;
  }

  /* Fixed column, so both views wrap the indicator names the same way. */
  .status {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 5px;
    width: 7.5em;
    color: var(--ink);
    font-weight: var(--fw-medium);
    white-space: nowrap;
  }

  .status :global(.icon) {
    flex: none;
  }

  /* One alert color: only a finding that falls short is red. */
  .status--not-met {
    color: var(--bad);
  }

  @media (prefers-reduced-motion: no-preference) {
    .view {
      animation: view-in 0.4s var(--ease);
    }

    @keyframes view-in {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
    }
  }

  @media (max-width: 479px) {
    .summary {
      padding: 28px 16px 20px;
    }

    .rows {
      padding-inline: 16px;
    }
  }
</style>
