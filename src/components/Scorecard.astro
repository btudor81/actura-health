---
// Hero visual: a sample monitoring summary that sets the vendor's own report
// beside an independent review of the same indicators. Statuses only, no figures.
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';

const { scorecard } = (await getHomepage()).hero;

const STATUS = {
  met: { label: 'Met', icon: 'check' },
  'not-met': { label: 'Not met', icon: 'x' },
  partial: { label: 'Partially met', icon: 'minus' },
} as const;

type StatusKey = keyof typeof STATUS;
---

<figure class="scorecard">
  <div class="scorecard__sheet on-light">
    <table>
      <caption>{scorecard.title}</caption>
      <thead>
        <tr>
          {scorecard.columns.map((column) => <th scope="col">{column}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          scorecard.rows.map((row, index) => {
            const vendor = STATUS[row.vendor as StatusKey];
            const review = STATUS[row.review as StatusKey];
            return (
              <tr>
                <th scope="row">{row.indicator}</th>
                <td>
                  <span class="status status--vendor">{vendor.label}</span>
                </td>
                <td>
                  <span class={`status status--${row.review}`} style={`--i:${index}`}>
                    <Icon name={review.icon} size={18} stroke={2.25} />
                    {review.label}
                  </span>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  <figcaption>{scorecard.footnote}</figcaption>
</figure>

<style>
  .scorecard {
    position: relative;
    margin: 0;
  }

  /* Second sheet behind the first: the source records under the summary */
  .scorecard::before {
    content: '';
    position: absolute;
    inset: 18px -14px 46px 14px;
    border: 1px solid var(--line-on-navy);
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, 0.07);
  }

  .scorecard__sheet {
    position: relative;
    padding: 24px 24px 12px;
    border-radius: var(--r-lg);
    background: var(--card);
    box-shadow: var(--shadow-panel);
    color: var(--body);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.35;
  }

  caption {
    padding-bottom: 16px;
    color: var(--ink);
    font-size: var(--fs-h4);
    font-weight: 600;
    letter-spacing: var(--tracking-head);
    text-align: left;
  }

  thead th {
    padding: 0 0 10px;
    color: var(--muted);
    font-weight: 500;
    text-align: left;
    vertical-align: bottom;
  }

  thead th:nth-child(n + 2),
  tbody td {
    padding-left: 12px;
  }

  tbody td {
    width: 1%;
    white-space: nowrap;
  }

  .status :global(.icon) {
    flex: none;
  }

  tbody th {
    padding: 14px 0;
    color: var(--ink);
    font-weight: 500;
    text-align: left;
  }

  tbody tr {
    border-top: 1px solid var(--line);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-weight: 600;
  }

  .status--vendor {
    color: var(--muted);
    font-weight: 500;
  }

  .status--met {
    color: var(--ok);
  }

  .status--not-met {
    color: var(--bad);
  }

  .status--partial {
    color: var(--gold-ink);
  }

  figcaption {
    position: relative;
    margin-top: 14px;
    padding-left: 4px;
    color: var(--on-navy-soft);
    font-size: var(--fs-small);
  }

  /* The independent findings arrive one by one, after the vendor column. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .status:not(.status--vendor) {
      animation: status-in 0.5s var(--ease) both;
      animation-delay: calc(0.6s + var(--i) * 0.18s);
    }
  }

  @keyframes status-in {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
  }

  @media (max-width: 479px) {
    .scorecard__sheet {
      padding: 20px 16px 8px;
    }

    .scorecard::before {
      inset: 14px -8px 44px 8px;
    }
  }
</style>
