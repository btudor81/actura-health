---
// Nested arcs rising from the bottom edge. Echoes the orbit in the logo mark.
interface Props {
  class?: string;
  /** Hang the arcs from the top edge instead of raising them from the bottom. */
  flip?: boolean;
}

const { class: className, flip = false } = Astro.props;
---

<svg
  class:list={['arcs', className, { 'arcs--flip': flip }]}
  viewBox="0 0 1440 400"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <ellipse cx="720" cy="560" rx="1280" ry="470" fill="var(--tint-2)"></ellipse>
  <ellipse cx="720" cy="590" rx="1060" ry="400" fill="var(--tint-3)"></ellipse>
  <ellipse cx="720" cy="620" rx="860" ry="330" fill="var(--tint-4)"></ellipse>
</svg>

<style>
  .arcs {
    display: block;
    width: 100%;
    pointer-events: none;
  }

  .arcs--flip {
    transform: scaleY(-1);
  }
</style>
