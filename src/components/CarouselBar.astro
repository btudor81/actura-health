---
// Slider controls: round arrows either side of a row of dashes, one dash per
// stop. The dashes are built by the script in Carousel.astro. Hidden without JS.
import Icon from './Icon.astro';

interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div class:list={['carousel__bar', className]}>
  <button type="button" class="carousel__btn" data-dir="-1" aria-label={`Previous ${label.toLowerCase()}`}>
    <Icon name="arrow-left" size={20} />
  </button>
  <div class="carousel__dots"></div>
  <button type="button" class="carousel__btn" data-dir="1" aria-label={`Next ${label.toLowerCase()}`}>
    <Icon name="arrow-right" size={20} />
  </button>
</div>

<style>
  .carousel__bar {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 32px;
  }

  :global(html.js) .carousel__bar {
    display: flex;
  }

  :global(html.js .carousel.is-static) .carousel__bar {
    display: none;
  }

  .carousel__dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* 24px hit area around a 4px dash; the current stop is longer and navy. */
  .carousel__dots :global(.carousel__dot) {
    display: grid;
    align-items: center;
    width: 18px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: width 0.3s var(--ease);
  }

  .carousel__dots :global(.carousel__dot::before) {
    content: '';
    height: 4px;
    border-radius: 2px;
    background: var(--grey-hover);
    transition: background-color 0.3s var(--ease);
  }

  .carousel__dots :global(.carousel__dot:hover::before) {
    background: var(--line-strong);
  }

  .carousel__dots :global(.carousel__dot[aria-current='true']) {
    width: 40px;
  }

  .carousel__dots :global(.carousel__dot[aria-current='true']::before) {
    background: var(--navy);
  }

  .carousel__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--grey);
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      opacity 0.2s var(--ease);
  }

  .carousel__btn:hover {
    background: var(--grey-hover);
  }

  .carousel__btn[aria-disabled='true'] {
    opacity: 0.4;
    cursor: default;
  }

  .carousel__btn[aria-disabled='true']:hover {
    background: var(--grey);
  }
</style>
