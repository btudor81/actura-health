---
// REVIEW: three backgrounds are on the page so one can be chosen. Keep the
// winner, delete the other two branches, the `option` / `duplicate` props and
// the option tag.
//   rails: vertical hairlines framing the copy, a soft glow behind the headline
//   dots:  dot grid, second headline row fades out
//   arcs:  nested circles top and bottom (the look until now)
// Rejected earlier, do not bring back: grain texture, plain gradient, animated fields.
import Arcs from './Arcs.astro';
import CapabilityLink from './CapabilityLink.astro';
import Icon from './Icon.astro';
import { getHomepage, getSite } from '../lib/content';
import { flag, headline } from '../lib/text';

interface Props {
  variant?: 'rails' | 'dots' | 'arcs';
  /** Review label shown in the corner. */
  option?: string;
  /** A repeat of the hero: its headline is not the page's h1. */
  duplicate?: boolean;
}

const { variant = 'arcs', option, duplicate = false } = Astro.props;
const { hero } = await getHomepage();
const site = await getSite();
const ctaHref = site.bookingUrl || '#contact';
const Title = duplicate ? 'p' : 'h1';
const titleId = duplicate ? `hero-title-${variant}` : 'hero-title';
---

<section
  class:list={['hero', `hero--${variant}`]}
  data-nav="light"
  aria-labelledby={duplicate ? undefined : titleId}
  aria-label={duplicate ? option : undefined}
>
  {
    variant === 'arcs' && (
      <>
        <Arcs class="hero__arcs hero__arcs--top" flip />
        <Arcs class="hero__arcs hero__arcs--bottom" />
      </>
    )
  }
  {variant === 'rails' && <div class="wrap hero__rails" aria-hidden="true" />}

  <div class="wrap hero__copy">
    <p class="eyebrow">{hero.eyebrow}</p>
    <Title id={titleId} class="h1 hero__title" set:html={headline(hero.headline)} />
    <p class="hero__sub" set:html={flag(hero.sub)} />
    <div class="hero__cta">
      <a class="btn btn--primary" href={ctaHref} data-event="booking_click">{site.primaryCta}</a>
      <CapabilityLink />
    </div>
  </div>

  <div class="wrap hero__foot">
    <ul role="list" class="hero__chips">
      {
        hero.chips.map((chip) => (
          <li>
            <span class="tile">
              <Icon name={chip.icon} size={22} />
            </span>
            {chip.text}
          </li>
        ))
      }
    </ul>
    {option && <p class="option-tag">{option}</p>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    padding-top: calc(var(--nav-h) + 14px);
    overflow: hidden;
    background: var(--tint);
  }

  /* A. Rails: a soft glow behind the headline, hairlines down both sides of the
     wrap (one full height, two shorter ones stepping in), a rule along the foot. */
  .hero--rails {
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(52% 46% at 50% 40%, var(--tint-3) 0%, rgba(211, 229, 251, 0) 100%),
      linear-gradient(180deg, var(--surface) 0%, var(--tint) 100%);
  }

  .hero__rails {
    --rail: linear-gradient(180deg, rgba(20, 52, 110, 0) 0%, rgba(20, 52, 110, 0.14) 28%, rgba(20, 52, 110, 0.14) 100%);
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(20, 52, 110, 0.14), rgba(20, 52, 110, 0.14)) left top / 1px 100% no-repeat,
      linear-gradient(rgba(20, 52, 110, 0.14), rgba(20, 52, 110, 0.14)) right top / 1px 100% no-repeat,
      var(--rail) left 48px bottom / 1px 84% no-repeat,
      var(--rail) right 48px bottom / 1px 84% no-repeat,
      var(--rail) left 72px bottom / 1px 76% no-repeat,
      var(--rail) right 72px bottom / 1px 76% no-repeat;
    pointer-events: none;
  }

  /* B. Dots: an even dot grid on a near-white ground, the second headline row easing out. */
  .hero--dots {
    background:
      radial-gradient(circle, rgba(20, 52, 110, 0.2) 1px, rgba(20, 52, 110, 0) 1.6px) center top / 26px 26px,
      linear-gradient(180deg, var(--tint) 0%, var(--surface) 100%);
  }

  .hero--dots .hero__title :global(.row:last-of-type) {
    background: linear-gradient(90deg, var(--ink) 12%, #6f80ad 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  /* On the pale foot of A and B the glass needs its own outline. */
  .hero--rails .hero__chips,
  .hero--dots .hero__chips {
    background: rgba(255, 255, 255, 0.8);
    box-shadow:
      0 0 0 1px var(--line),
      var(--shadow-float);
  }

  /* C. Arcs stay a whisper behind the copy. */
  .hero :global(.hero__arcs) {
    position: absolute;
    left: 0;
    opacity: 0.4;
  }

  /* Shallower at the top so the arcs sit behind the nav, not behind the headline. */
  .hero :global(.hero__arcs--top) {
    top: 0;
    height: 26%;
  }

  .hero :global(.hero__arcs--bottom) {
    bottom: 0;
    height: 44%;
  }

  .hero__copy {
    position: relative;
    display: grid;
    flex: 1;
    align-content: center;
    justify-items: center;
    padding-block: clamp(48px, 6vw, 80px);
    text-align: center;
  }

  .hero__copy .eyebrow {
    justify-self: center;
    margin-bottom: 24px;
  }

  .hero__sub {
    max-width: 52ch;
    margin-top: 24px;
    color: var(--muted);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .hero__foot {
    position: relative;
    display: flex;
    justify-content: center;
    padding-bottom: clamp(32px, 4vw, 56px);
  }

  .hero__foot .option-tag {
    position: absolute;
    bottom: 16px;
    left: 16px;
  }

  /* Three promises on a glass bar. */
  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 36px;
    padding: 12px 28px 12px 12px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-float);
  }

  .hero__chips li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    line-height: 1.3;
  }

  .hero__chips .tile {
    width: 40px;
    height: 40px;
  }

  @media (min-width: 1024px) {
    .hero__title :global(.row) {
      white-space: nowrap;
    }
  }

  @media (max-width: 1023px) {
    .hero__foot {
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .hero__foot .option-tag {
      position: static;
    }

    /* Narrow screens: only the outer pair of rails. */
    .hero__rails {
      background-size: 1px 100%, 1px 100%, 0 0, 0 0, 0 0, 0 0;
    }
  }

  @media (max-width: 767px) {
    .hero__chips {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      padding: 12px;
    }
  }

  @media (max-width: 599px) {
    .hero__cta {
      width: 100%;
    }

    .hero__cta :global(.btn) {
      width: 100%;
    }
  }
</style>
