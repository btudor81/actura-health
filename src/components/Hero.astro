---
import CapabilityLink from './CapabilityLink.astro';
import { getHomepage, getSite } from '../lib/content';
import { flag, headline } from '../lib/text';

const { hero } = await getHomepage();
const site = await getSite();
const ctaHref = site.bookingUrl || '#contact';
---

<section class="hero on-navy" data-nav="dark" aria-labelledby="hero-title">
  <picture class="hero__media">
    <source srcset="/img/photo-hero.webp" type="image/webp" />
    <img src="/img/photo-hero.jpg" alt="" width="2400" height="1590" fetchpriority="high" decoding="async" />
  </picture>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title" set:html={headline(hero.headline)} />
      <p class="hero__sub" set:html={flag(hero.sub)} />
      <div class="hero__cta">
        <a class="btn btn--gold" href={ctaHref} data-event="booking_click">{site.primaryCta}</a>
        <CapabilityLink variant="ghost-light" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100vh;
    min-height: min(100dvh, 920px);
    padding-block: calc(var(--nav-h) + 14px + clamp(48px, 6vw, 80px)) clamp(56px, 7vw, 96px);
    overflow: hidden;
    background: var(--navy);
    color: var(--on-navy-soft);
  }

  /* Photo holds the right side; the reviewer's hands stay clear of the headline. */
  .hero__media {
    position: absolute;
    inset: 0 0 0 30%;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0% 42%;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--navy) 0%,
      var(--navy) 32%,
      rgba(15, 0, 104, 0.9) 50%,
      rgba(15, 0, 104, 0.4) 70%,
      rgba(15, 0, 104, 0.1) 100%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__copy {
    max-width: 800px;
  }

  .hero__eyebrow {
    display: inline-block;
    margin-bottom: 24px;
    padding: 6px 14px;
    border: 1px solid rgba(216, 155, 0, 0.3);
    border-radius: 999px;
    background: rgba(10, 0, 71, 0.55);
    color: var(--on-navy);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  h1 {
    color: var(--on-navy);
  }

  .hero__sub {
    max-width: 50ch;
    margin-top: 24px;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  @media (min-width: 1024px) {
    h1 :global(.row) {
      white-space: nowrap;
    }
  }

  @media (max-width: 1023px) {
    .hero {
      min-height: 0;
      padding-bottom: clamp(220px, 44vw, 380px);
    }

    /* Photo drops to the lower half and fades up into the navy. */
    .hero__media {
      inset: auto 0 0 0;
      height: clamp(260px, 56vw, 460px);
    }

    .hero__media img {
      object-position: 60% 40%;
    }

    .hero::after {
      background: linear-gradient(180deg, var(--navy) 0%, var(--navy) 52%, rgba(15, 0, 104, 0.35) 100%);
    }
  }

  @media (max-width: 599px) {
    .hero__cta :global(.btn) {
      width: 100%;
    }
  }
</style>
