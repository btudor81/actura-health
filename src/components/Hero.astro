---
import Arcs from './Arcs.astro';
import CapabilityLink from './CapabilityLink.astro';
import Icon from './Icon.astro';
import { getHomepage, getSite } from '../lib/content';
import { flag, headline } from '../lib/text';

const { hero } = await getHomepage();
const site = await getSite();
const ctaHref = site.bookingUrl || '#contact';
---

<section class="hero" data-nav="light" aria-labelledby="hero-title">
  <Arcs class="hero__arcs hero__arcs--top" flip />
  <Arcs class="hero__arcs hero__arcs--bottom" />

  <div class="wrap hero__copy">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title" set:html={headline(hero.headline)} />
    <p class="hero__sub" set:html={flag(hero.sub)} />
    <div class="hero__cta">
      <a class="btn btn--primary" href={ctaHref} data-event="booking_click">{site.primaryCta}</a>
      <CapabilityLink />
    </div>
  </div>

  <div class="wrap hero__foot">
    <ul role="list" class="hero__chips">
      {
        hero.chips.map((chip) => (
          <li>
            <span class="tile">
              <Icon name={chip.icon} size={22} />
            </span>
            {chip.text}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    padding-top: calc(var(--nav-h) + 14px);
    overflow: hidden;
    background: var(--tint);
  }

  /* Arcs stay a whisper behind the copy. */
  .hero :global(.hero__arcs) {
    position: absolute;
    left: 0;
    opacity: 0.4;
  }

  /* Shallower at the top so the arcs sit behind the nav, not behind the headline. */
  .hero :global(.hero__arcs--top) {
    top: 0;
    height: 26%;
  }

  .hero :global(.hero__arcs--bottom) {
    bottom: 0;
    height: 44%;
  }

  .hero__copy {
    position: relative;
    display: grid;
    flex: 1;
    align-content: center;
    justify-items: center;
    padding-block: clamp(48px, 6vw, 80px);
    text-align: center;
  }

  .hero__copy .eyebrow {
    justify-self: center;
    margin-bottom: 24px;
  }

  .hero__sub {
    max-width: 52ch;
    margin-top: 24px;
    color: var(--muted);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .hero__foot {
    position: relative;
    display: flex;
    justify-content: center;
    padding-bottom: clamp(32px, 4vw, 56px);
  }

  /* Three promises on a glass bar, sitting on the arcs. */
  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 36px;
    padding: 12px 28px 12px 12px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-float);
  }

  .hero__chips li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    line-height: 1.3;
  }

  .hero__chips .tile {
    width: 40px;
    height: 40px;
  }

  @media (min-width: 1024px) {
    h1 :global(.row) {
      white-space: nowrap;
    }
  }

  @media (max-width: 767px) {
    .hero__chips {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      padding: 12px;
    }
  }

  @media (max-width: 599px) {
    .hero__cta {
      width: 100%;
    }

    .hero__cta :global(.btn) {
      width: 100%;
    }
  }
</style>
