---
// Nine services as photo cards in one row. Stage 1: cards are plain blocks.
// Once the service pages exist each card becomes a link to /services/[slug].
// Photos: public/img/service-[slug].{webp,jpg}, one per service, never reused.
import CapabilityLink from './CapabilityLink.astro';
import Carousel from './Carousel.astro';
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { flag, headline } from '../lib/text';

const { services } = await getHomepage();
const cards = services.clusters.flatMap((cluster, clusterIndex) =>
  cluster.items.map((item) => ({ ...item, cluster: cluster.title, clusterIndex })),
);
---

<section id="services" class="section services" data-nav="light" aria-labelledby="services-title">
  <div class="wrap">
    <div class="section__head section__head--center">
      <p class="eyebrow">{services.eyebrow}</p>
      <h2 id="services-title" set:html={headline(services.headline)} />
      <p class="lead" set:html={flag(services.sub)} />
      <CapabilityLink />
    </div>
  </div>

  <div class="reveal">
    <Carousel label="Services" bleed>
      {
        cards.map((card) => (
          <li class="svc">
            <picture>
              <source srcset={`/img/service-${card.slug}.webp`} type="image/webp" />
              <img
                src={`/img/service-${card.slug}.jpg`}
                alt=""
                width="880"
                height="1100"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <span class="tile svc__icon">
              <Icon name={card.icon} />
            </span>
            <div class="svc__body">
              <p class="svc__meta">
                {card.cluster}
                <span class="svc__dashes" aria-hidden="true">
                  {services.clusters.map((_, index) => <i class:list={{ 'is-on': index === card.clusterIndex }} />)}
                </span>
              </p>
              <h3>{card.title}</h3>
              <p class="svc__text" set:html={flag(card.text)} />
            </div>
          </li>
        ))
      }
    </Carousel>
  </div>
</section>

<style>
  .section__head :global(.btn) {
    margin-top: 8px;
  }

  .svc {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: clamp(280px, 78vw, 400px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--tint-3);
    color: #ffffff;
    isolation: isolate;
  }

  .svc picture,
  .svc img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Scrim under the copy: one long eased ramp, near black with a trace of blue. No blur.
     0.74 where the copy starts keeps white text above 4.5:1 even on a white photo. */
  .svc::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(9, 11, 24, 0) 18%,
      rgba(9, 11, 24, 0.1) 29%,
      rgba(9, 11, 24, 0.32) 40%,
      rgba(9, 11, 24, 0.56) 49%,
      rgba(9, 11, 24, 0.74) 57%,
      rgba(9, 11, 24, 0.84) 72%,
      rgba(9, 11, 24, 0.9) 100%
    );
  }

  .svc__icon {
    position: absolute;
    top: 16px;
    left: 16px;
  }

  .svc__body {
    width: 100%;
    padding: 24px;
  }

  .svc__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  /* One dash per service group, the card's own group lit in gold. */
  .svc__dashes {
    display: flex;
    gap: 5px;
  }

  .svc__dashes i {
    width: 12px;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.4);
  }

  .svc__dashes i.is-on {
    background: var(--gold);
  }

  /* Two title rows and three text rows reserved, so the rule sits level on every card. */
  .svc h3 {
    display: flex;
    align-items: flex-end;
    min-height: 2.5em;
    margin-top: 10px;
    color: #ffffff;
    font-size: var(--fs-h4);
    line-height: 1.25;
  }

  .svc__text {
    min-height: 4.5em;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.24);
    box-sizing: content-box;
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  @media (max-width: 479px) {
    .svc {
      aspect-ratio: 3 / 4;
    }

    .svc__body {
      padding: 20px;
    }
  }
</style>
