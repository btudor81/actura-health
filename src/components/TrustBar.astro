---
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { flag } from '../lib/text';

const { trust } = await getHomepage();
---

<section class="trust" aria-labelledby="trust-label">
  <div class="wrap">
    <p id="trust-label" class="trust__label">{trust.label}</p>
    <ul role="list" class="trust__list">
      {
        trust.items.map((item) => (
          <li>
            <Icon name={item.icon} size={30} />
            <span set:html={flag(item.text)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trust {
    padding-block: 48px 56px;
    border-bottom: 1px solid var(--line);
  }

  .trust__label {
    margin-bottom: 28px;
    color: var(--muted);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .trust__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  li {
    display: grid;
    align-content: start;
    gap: 14px;
    padding-inline: 24px;
    border-left: 1px solid var(--line);
    color: var(--ink);
    font-weight: 500;
    line-height: 1.3;
  }

  li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  li :global(.icon) {
    color: var(--gold-ink);
  }

  @media (max-width: 1023px) {
    .trust__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 0;
    }

    li:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 479px) {
    .trust__list {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    li {
      grid-template-columns: auto 1fr;
      align-items: center;
      padding-inline: 0;
      border-left: 0;
    }
  }
</style>
