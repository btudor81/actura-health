---
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { rows } from '../lib/text';

const { trust } = await getHomepage();
---

<section class="trust" data-nav="light" aria-labelledby="trust-label">
  <div class="wrap">
    <p id="trust-label" class="trust__label">{trust.label}</p>
    <ul role="list" class="trust__list">
      {
        trust.items.map((item) => (
          <li>
            <Icon name={item.icon} size={30} />
            <span set:html={rows(item.text)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trust {
    padding-block: 48px 56px;
    border-bottom: 1px solid var(--line);
  }

  .trust__label {
    margin-bottom: 28px;
    color: var(--muted);
    font-size: var(--fs-small);
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .trust__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    row-gap: 36px;
  }

  /* Every label is set on two rows: the break is in the content, the rows never wrap. */
  li {
    display: grid;
    flex: 0 0 20%;
    align-content: start;
    justify-items: center;
    gap: 14px;
    padding-inline: 12px;
    border-left: 1px solid var(--line);
    color: var(--ink);
    line-height: 1.3;
    text-align: center;
    white-space: nowrap;
  }

  li:first-child {
    border-left: 0;
  }

  li :global(.icon) {
    color: var(--gold);
  }

  @media (max-width: 1199px) {
    li {
      flex-basis: 33.333%;
      border-left: 0;
    }
  }

  @media (max-width: 767px) {
    li {
      flex-basis: 50%;
    }
  }

  @media (max-width: 479px) {
    .trust__list {
      row-gap: 20px;
    }

    li {
      flex-basis: 100%;
      grid-template-columns: auto 1fr;
      align-items: center;
      justify-items: start;
      padding-inline: 0;
      text-align: left;
    }

    .trust__label {
      text-align: left;
    }
  }
</style>
