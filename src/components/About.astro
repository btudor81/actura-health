---
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { flag, headline } from '../lib/text';

const { about } = await getHomepage();
const { diagram } = about;
---

<section id="about" class="section section--tint about" data-nav="light" aria-labelledby="about-title">
  <div class="wrap">
    <div class="about__grid">
      <div class="about__copy">
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 id="about-title" set:html={headline(about.headline)} />
        {about.body.map((paragraph) => <p set:html={flag(paragraph)} />)}
      </div>

      <picture class="about__photo reveal">
        <source srcset="/img/photo-about.webp" type="image/webp" />
        <img
          src="/img/photo-about.jpg"
          alt="A clinician in a white coat writing notes on a clipboard."
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>

    <figure class="layers reveal">
      <ol role="list">
        <li class="layers__node">
          <span class="tile"><Icon name="building-community" /></span>
          <p><strong>{diagram.agency.title}</strong>{diagram.agency.text}</p>
        </li>
        <li class="layers__link">
          <Icon name="arrow-narrow-left" size={24} />
          {diagram.linkTop}
        </li>
        <li class="layers__node layers__node--actura">
          <span class="tile tile--on-navy"><Icon name="scale" /></span>
          <p><strong>{diagram.actura.title}</strong>{diagram.actura.text}</p>
        </li>
        <li class="layers__link">
          {diagram.linkBottom}
          <Icon name="arrow-narrow-right" size={24} />
        </li>
        <li class="layers__node">
          <span class="tile"><Icon name="stethoscope" /></span>
          <p><strong>{diagram.vendor.title}</strong>{diagram.vendor.text}</p>
        </li>
      </ol>
      <figcaption class="small">
        <Icon name="link-off" size={20} />
        {diagram.caption}
      </figcaption>
    </figure>

    <ul role="list" class="values">
      {
        about.values.map((value) => (
          <li>
            <Icon name={value.icon} size={30} />
            <h3>{value.title}</h3>
            <p set:html={flag(value.text)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .about__copy {
    display: grid;
    justify-items: start;
    gap: 24px;
  }

  .about__copy p:not(.eyebrow) {
    max-width: 62ch;
  }

  .about__photo {
    display: block;
    overflow: hidden;
    border-radius: var(--r-lg);
  }

  .about__photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 46% 50%;
  }

  /* Three parties in one row: who Actura reports to, and who it reviews. */
  .layers {
    margin: clamp(48px, 6vw, 80px) 0 0;
  }

  .layers ol {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
  }

  .layers__node {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 16px;
    height: 100%;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--card);
    color: var(--muted);
    line-height: 1.35;
  }

  .layers__node strong {
    display: block;
    color: var(--ink);
    font-weight: var(--fw-medium);
  }

  .layers__node--actura {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--on-navy-soft);
  }

  .layers__node--actura strong {
    color: var(--on-navy);
  }

  .layers__link {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 190px;
    color: var(--ink);
    font-size: var(--fs-small);
    line-height: 1.3;
  }

  .layers__link :global(.icon) {
    flex: none;
  }

  figcaption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
    color: var(--muted);
  }

  .values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: clamp(36px, 4vw, 48px);
    border-top: 1px solid var(--line);
  }

  .values li {
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .values :global(.icon) {
    margin-bottom: 6px;
    color: var(--ink);
  }

  .values h3 {
    font-size: var(--fs-h4);
  }

  .values p {
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__photo img {
      aspect-ratio: 16 / 10;
    }

    /* Stack the three parties; arrows turn to point up and down. */
    .layers ol {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .layers__link {
      max-width: none;
      padding: 12px 0 12px 34px;
    }

    .layers__link :global(.icon) {
      order: -1;
      transform: rotate(90deg);
    }
  }

  @media (max-width: 767px) {
    .values {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
