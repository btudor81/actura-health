---
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { flag, headline } from '../lib/text';

const { about } = await getHomepage();
---

<section id="about" class="section about" data-nav="light" aria-labelledby="about-title">
  <div class="wrap">
    <div class="about__grid">
      <div class="about__copy">
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 id="about-title" set:html={headline(about.headline)} />
        {about.body.map((paragraph) => <p set:html={flag(paragraph)} />)}
      </div>

      <picture class="about__photo reveal">
        <source srcset="/img/photo-about.webp" type="image/webp" />
        <img
          src="/img/photo-about.jpg"
          alt="A clinician in a white coat writing notes on a clipboard."
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>

    <ul role="list" class="values">
      {
        about.values.map((value) => (
          <li>
            <Icon name={value.icon} size={30} />
            <h3>{value.title}</h3>
            <p set:html={flag(value.text)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .about__copy {
    display: grid;
    justify-items: start;
    gap: 24px;
  }

  .about__copy p:not(.eyebrow) {
    max-width: 62ch;
  }

  .about__photo {
    display: block;
    overflow: hidden;
    border-radius: var(--r-lg);
  }

  .about__photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 46% 50%;
  }

  .values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: clamp(36px, 4vw, 48px);
    border-top: 1px solid var(--line);
  }

  .values li {
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .values :global(.icon) {
    margin-bottom: 6px;
    color: var(--ink);
  }

  .values h3 {
    font-size: var(--fs-h4);
  }

  .values p {
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__photo img {
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 767px) {
    .values {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
