---
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { flag, headline } from '../lib/text';

const { about } = await getHomepage();
---

<section id="about" class="section about" data-nav="light" aria-labelledby="about-title">
  <div class="wrap">
    <div class="about__grid">
      <div class="about__copy">
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 id="about-title" set:html={headline(about.headline)} />
        {about.body.map((paragraph) => <p class="lead" set:html={flag(paragraph)} />)}

        <ul role="list" class="values">
          {
            about.values.map((value) => (
              <li>
                <span class="tick">
                  <Icon name="check" size={16} stroke={2.5} />
                </span>
                <div>
                  <h3>{value.title}</h3>
                  <p set:html={flag(value.text)} />
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <picture class="about__photo reveal">
        <source srcset="/img/photo-about.webp" type="image/webp" />
        <img
          src="/img/photo-about.jpg"
          alt="A clinician in a white coat writing notes on a clipboard."
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .about__copy {
    display: grid;
    justify-items: start;
    gap: 24px;
  }


  .about__photo {
    display: block;
    overflow: hidden;
    border-radius: var(--r-lg);
  }

  .about__photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 46% 50%;
  }

  .values {
    display: grid;
    gap: 20px;
    margin-top: 8px;
  }

  .values li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
  }

  .values .tick {
    margin-top: 2px;
  }

  .values h3 {
    font-size: var(--fs-h4);
    line-height: 1.25;
  }

  .values p {
    max-width: 52ch;
    margin-top: 4px;
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__photo img {
      aspect-ratio: 16 / 10;
    }
  }
</style>
