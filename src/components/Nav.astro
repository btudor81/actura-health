---
// The bar always takes a color close to the ground it sits on: navy glass over
// navy sections, white over light ones. Sections declare data-nav="dark|light".
import Icon from './Icon.astro';
import { getSite } from '../lib/content';

interface Props {
  theme?: 'dark' | 'light';
}

const { theme = 'light' } = Astro.props;
const site = await getSite();
const ctaHref = site.bookingUrl || '/#contact';
---

<header class:list={['nav', theme === 'light' ? 'nav--light on-light' : 'on-navy']}>
  <div class="wrap nav__bar">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <img class="brand__mark brand__mark--light" src="/img/logo-mark-light.png" alt="" width="183" height="192" />
      <img class="brand__mark brand__mark--dark" src="/img/logo-mark.png" alt="" width="183" height="192" />
      <span>{site.name}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul role="list">
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <a class="btn btn--primary btn--sm nav__cta" href={ctaHref} data-event="booking_click">{site.primaryCta}</a>

    <details class="nav__menu">
      <summary>
        <Icon name="menu-2" size={26} />
        <span class="visually-hidden">Menu</span>
      </summary>
      <nav aria-label="Primary, mobile">
        <ul role="list">
          {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a class="btn btn--primary nav__cta" href={ctaHref} data-event="booking_click">{site.primaryCta}</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('.nav');
  const menu = document.querySelector<HTMLDetailsElement>('.nav__menu');

  // Close the mobile menu after a link is chosen. Without JS the menu still works.
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) menu.open = false;
  });

  // Match the bar to whichever section is passing behind it.
  const zones = document.querySelectorAll<HTMLElement>('[data-nav]');
  if (nav && zones.length && 'IntersectionObserver' in window) {
    let observer: IntersectionObserver | undefined;

    const setTheme = (theme: string | undefined) => {
      const light = theme === 'light';
      nav.classList.toggle('nav--light', light);
      nav.classList.toggle('on-light', light);
      nav.classList.toggle('on-navy', !light);
    };

    const watch = () => {
      observer?.disconnect();
      const box = nav.getBoundingClientRect();
      const line = Math.round(box.top + box.height / 2);
      observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) setTheme((entry.target as HTMLElement).dataset.nav);
          }
        },
        { rootMargin: `-${line}px 0px -${Math.max(window.innerHeight - line - 1, 0)}px 0px` },
      );
      zones.forEach((zone) => observer?.observe(zone));
    };

    watch();
    window.addEventListener('resize', watch);
  }
</script>

<style>
  /* Without JS the bar sits at the top of the page and scrolls away with it. */
  .nav {
    position: absolute;
    top: 14px;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    pointer-events: none;
  }

  :global(html.js) .nav {
    position: fixed;
  }

  .nav__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: var(--nav-h);
    padding: 10px 12px 10px 24px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-md);
    background: rgba(18, 5, 108, 0.72);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    color: var(--on-navy);
    line-height: var(--lh-body);
    pointer-events: auto;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .nav--light .nav__bar {
    border-color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 0 0 1px var(--line), var(--shadow-float);
    color: var(--ink);
  }

  /* The wordmark repeats the logo, which is set in Outfit SemiBold. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: inherit;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .brand__mark {
    width: auto;
    height: 34px;
  }

  .brand__mark--dark,
  .nav--light .brand__mark--light {
    display: none;
  }

  .nav--light .brand__mark--dark {
    display: block;
  }

  .nav__links {
    margin-inline: auto;
  }

  .nav__links ul {
    display: flex;
    gap: 8px;
  }

  .nav__links a {
    display: block;
    padding: 10px 16px;
    border-radius: var(--r-sm);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }

  .nav__links a:hover,
  .nav__menu[open] summary {
    background: rgba(255, 255, 255, 0.12);
  }

  .nav--light .nav__links a:hover,
  .nav--light .nav__menu[open] summary {
    background: var(--tint);
  }

  .nav__menu {
    display: none;
  }

  .nav__menu summary {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--r-sm);
    cursor: pointer;
    list-style: none;
  }

  .nav__menu summary::-webkit-details-marker {
    display: none;
  }

  .nav__menu nav {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-md);
    background: var(--navy);
    box-shadow: var(--shadow-float);
  }

  .nav--light .nav__menu nav {
    border-color: var(--line);
    background: var(--surface);
  }

  .nav__menu ul {
    display: grid;
    gap: 4px;
  }

  .nav__menu a:not(.btn) {
    display: block;
    padding: 14px 16px;
    border-radius: var(--r-sm);
    color: inherit;
    text-decoration: none;
  }

  .nav__menu .btn {
    width: 100%;
    margin-top: 8px;
  }

  @media (max-width: 1023px) {
    .nav__links {
      display: none;
    }

    .nav__bar > .nav__cta {
      margin-left: auto;
    }

    .nav__menu {
      display: block;
    }
  }

  @media (max-width: 599px) {
    .nav__bar {
      padding-left: 16px;
    }

    .nav__bar > .nav__cta {
      display: none;
    }

    .nav__menu {
      margin-left: auto;
    }

    .brand {
      font-size: 1rem;
    }

    .brand__mark {
      height: 32px;
    }
  }
</style>
