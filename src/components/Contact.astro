---
// Closing section. Plain HTML form handled by Netlify Forms: works with JS off.
import CapabilityLink from './CapabilityLink.astro';
import Icon from './Icon.astro';
import { getHomepage, getSite } from '../lib/content';
import { flag, headline } from '../lib/text';

const { contact } = await getHomepage();
const site = await getSite();
const { form } = contact;
---

<section id="contact" class="section contact" data-nav="light" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="panel contact__panel">
      <div class="contact__copy">
        <h2 id="contact-title" set:html={headline(contact.headline)} />
        <p class="lead" set:html={flag(contact.sub)} />

        <div class="contact__actions">
          {
            site.bookingUrl && (
              <a class="btn btn--primary" href={site.bookingUrl} data-event="booking_click">
                <Icon name="calendar-event" size={22} />
                {site.primaryCta}
              </a>
            )
          }
          <CapabilityLink />
        </div>
        <p class="contact__friction" set:html={flag(contact.friction)} />

        <ul role="list" class="contact__direct">
          <li class="contact__email">
            <Icon name="mail" size={24} />
            <span>{site.contactEmail}</span>
            <button type="button" class="copy" data-copy={site.contactEmail} aria-label="Copy email address">
              <Icon name="copy" size={20} class="copy__idle" />
              <Icon name="check" size={20} stroke={2} class="copy__done" />
            </button>
            <span class="visually-hidden" role="status"></span>
          </li>
          {
            site.linkedinUrl && (
              <li>
                <a href={site.linkedinUrl} rel="noopener">
                  <Icon name="brand-linkedin" size={24} />
                  Actura Health on LinkedIn
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <form
        class="mock form"
        name="contact"
        method="POST"
        action="/contact/thanks/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        aria-labelledby="contact-title"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="form__trap">
          <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="field">
          <label for="cf-name">{form.name}</label>
          <input id="cf-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="cf-agency">{form.agency}</label>
          <input id="cf-agency" name="agency" type="text" autocomplete="organization" required />
        </div>
        <div class="field">
          <label for="cf-email">{form.email}</label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="cf-message">{form.message}</label>
          <textarea id="cf-message" name="message" rows="5" required></textarea>
        </div>

        <button class="btn btn--primary" type="submit" data-event="form_submit">{form.submit}</button>
      </form>
    </div>
  </div>
</section>

<script>
  // Copy the address, show a check for a moment, tell assistive tech.
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
    const status = button.parentElement?.querySelector<HTMLElement>('[role="status"]');
    let timer = 0;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        return;
      }
      button.classList.add('is-copied');
      if (status) status.textContent = 'Email address copied';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.classList.remove('is-copied');
        if (status) status.textContent = '';
      }, 2000);
    });
  });
</script>

<style>
  .contact {
    padding-top: 0;
  }

  .contact__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(32px, 5vw, 80px);
    padding: clamp(24px, 4.5vw, 64px);
    background: linear-gradient(160deg, var(--tint-2) 0%, var(--tint-3) 100%);
  }

  .contact__copy {
    display: grid;
    gap: 20px;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }

  .contact__friction {
    max-width: 46ch;
    color: var(--ink);
  }

  .contact__direct {
    display: grid;
    gap: 8px;
    margin-top: 8px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .contact__direct a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: rgba(21, 19, 74, 0.3);
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
  }

  .contact__direct a:hover {
    text-decoration-color: var(--navy);
  }

  .contact__direct :global(.icon) {
    flex: none;
    color: var(--navy);
  }

  .contact__email {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--ink);
  }

  .contact__email > span:not(.visually-hidden) {
    overflow-wrap: anywhere;
  }

  /* Needs JS (clipboard), so it only appears once JS has marked the document. */
  .copy {
    display: none;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--control-edge);
    border-radius: var(--r-sm);
    background: var(--control);
    box-shadow: var(--shadow-control);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  :global(html.js) .copy {
    display: grid;
  }

  .copy:hover {
    border-color: var(--control-edge-hover);
    background: var(--control-hover);
  }

  .copy :global(.copy__done),
  .copy.is-copied :global(.copy__idle) {
    display: none;
  }

  .copy.is-copied :global(.copy__done) {
    display: block;
  }

  /* The form sits in the panel's own color: a faint lift, not a white slab. */
  .form {
    display: grid;
    gap: 22px;
    padding: clamp(24px, 3vw, 40px);
    border-color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.4);
    box-shadow: none;
  }

  .form__trap {
    display: none;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  label {
    color: var(--ink);
    font-weight: var(--fw-medium);
  }

  input,
  textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--card);
    box-shadow: inset 0 2px 3px rgba(21, 19, 74, 0.05);
    color: var(--body);
    font: inherit;
  }

  input {
    min-height: 56px;
  }

  textarea {
    resize: vertical;
  }

  input:hover,
  textarea:hover,
  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--navy);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline-offset: 2px;
  }

  input:user-invalid,
  textarea:user-invalid {
    border-color: var(--bad);
    background: var(--bad-wash);
  }

  .form .btn {
    justify-self: start;
  }

  @media (max-width: 1023px) {
    .contact__panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Phone: the copy button stands in for the envelope, so the address stays on one row. */
  @media (max-width: 479px) {
    .contact__email > :global(.icon) {
      display: none;
    }
  }

  @media (max-width: 599px) {
    .form .btn {
      justify-self: stretch;
    }

    /* The long download label may take two rows inside the narrow panel. */
    .contact__actions :global(.btn) {
      width: 100%;
      white-space: normal;
    }
  }
</style>
