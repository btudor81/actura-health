---
// Closing section. Plain HTML form handled by Netlify Forms: works with JS off.
import CapabilityLink from './CapabilityLink.astro';
import Icon from './Icon.astro';
import { getHomepage, getSite } from '../lib/content';
import { flag, headline } from '../lib/text';

const { contact } = await getHomepage();
const site = await getSite();
const { form } = contact;
---

<section id="contact" class="section section--navy on-navy contact" aria-labelledby="contact-title">
  <div class="wrap contact__grid">
    <div class="contact__copy">
      <h2 id="contact-title" set:html={headline(contact.headline)} />
      <p class="lead" set:html={flag(contact.sub)} />

      <div class="contact__actions">
        {
          site.bookingUrl && (
            <a class="btn btn--gold" href={site.bookingUrl} data-event="booking_click">
              <Icon name="calendar-event" size={22} />
              {site.primaryCta}
            </a>
          )
        }
        <CapabilityLink variant="ghost-light" />
      </div>
      <p class="contact__friction" set:html={flag(contact.friction)} />

      <ul role="list" class="contact__direct">
        <li>
          <a href={`mailto:${site.contactEmail}`}>
            <Icon name="mail" size={24} />
            {site.contactEmail}
          </a>
        </li>
        {
          site.linkedinUrl && (
            <li>
              <a href={site.linkedinUrl} rel="noopener">
                <Icon name="brand-linkedin" size={24} />
                Actura Health on LinkedIn
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <form
      class="form on-light"
      name="contact"
      method="POST"
      action="/contact/thanks/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      aria-labelledby="contact-title"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="form__req small">All fields are required.</p>
      <p class="form__trap">
        <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="field">
        <label for="cf-name">{form.name}</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="cf-agency">{form.agency}</label>
        <input id="cf-agency" name="agency" type="text" autocomplete="organization" required />
      </div>
      <div class="field">
        <label for="cf-email">{form.email}</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="cf-message">{form.message}</label>
        <textarea id="cf-message" name="message" rows="5" required></textarea>
      </div>

      <button class="btn btn--primary" type="submit" data-event="form_submit">{form.submit}</button>
      <p class="form__note small" set:html={flag(form.note)} />
    </form>
  </div>
</section>

<style>
  .contact {
    background:
      radial-gradient(55% 70% at 100% 0%, var(--navy-glow), transparent 70%),
      var(--navy);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(40px, 6vw, 96px);
  }

  .contact__copy {
    display: grid;
    gap: 20px;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 16px;
  }

  .contact__friction {
    max-width: 46ch;
    color: var(--on-navy);
  }

  .contact__direct {
    display: grid;
    gap: 12px;
    margin-top: 12px;
    padding-top: 28px;
    border-top: 1px solid var(--line-on-navy);
  }

  .contact__direct a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--on-navy);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
  }

  .contact__direct a:hover {
    text-decoration-color: var(--gold);
  }

  .contact__direct :global(.icon) {
    flex: none;
    color: var(--gold);
  }

  .form {
    display: grid;
    gap: 22px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--r-lg);
    background: var(--card);
    color: var(--body);
    box-shadow: var(--shadow-panel);
  }

  .form__trap {
    display: none;
  }

  .form__req {
    color: var(--muted);
  }

  .field {
    display: grid;
    gap: 8px;
  }

  label {
    color: var(--ink);
    font-weight: 500;
  }

  input,
  textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--card);
    color: var(--body);
    font: inherit;
  }

  input {
    min-height: 56px;
  }

  textarea {
    resize: vertical;
  }

  input:hover,
  textarea:hover {
    border-color: var(--navy);
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--navy);
    outline-offset: 2px;
  }

  input:user-invalid,
  textarea:user-invalid {
    border-color: var(--bad);
    background: var(--bad-wash);
  }

  .form .btn {
    justify-self: start;
  }

  .form__note {
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 599px) {
    .form .btn {
      justify-self: stretch;
    }

    .contact__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
