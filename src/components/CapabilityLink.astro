---
// "Download capability statement" button: saves the PDF from public/files.
// With no file set it renders as a flagged, non-clickable state so a dead link cannot ship.
import Icon from './Icon.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const url = site.capabilityStatementUrl;
---

{
  url ? (
    <a class="btn btn--ghost" href={url} download="Actura-Health-Capability-Statement.pdf" data-event="capability_download">
      <Icon name="download" size={22} />
      {site.secondaryCta}
    </a>
  ) : (
    <span class="btn btn--ghost is-pending">
      <Icon name="download" size={22} />
      {site.secondaryCta}
      <mark class="confirm">Pending</mark>
    </span>
  )
}
