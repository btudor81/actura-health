---
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { flag, headline } from '../lib/text';

const { benefits } = await getHomepage();
const { commitments } = benefits;
---

<section class="section section--navy on-navy benefits" aria-labelledby="benefits-title">
  <div class="wrap benefits__grid">
    <div>
      <div class="section__head">
        <h2 id="benefits-title" set:html={headline(benefits.headline)} />
        <p class="lead" set:html={flag(benefits.sub)} />
      </div>

      <ul role="list" class="benefits__list">
        {
          benefits.items.map((item, index) => (
            <li class="reveal" style={`--i:${index}`}>
              <span class="tile tile--on-navy">
                <Icon name={item.icon} />
              </span>
              <h3>{item.title}</h3>
              <p set:html={flag(item.text)} />
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="commit on-light reveal" aria-labelledby="commit-title">
      <h3 id="commit-title">{commitments.title}</h3>
      <ul role="list">
        {
          commitments.items.map((item) => (
            <li>
              <span class="tile">
                <Icon name={item.icon} />
              </span>
              <div>
                <h4>{item.title}</h4>
                <p set:html={flag(item.text)} />
              </div>
            </li>
          ))
        }
      </ul>
      <p class="commit__note small" set:html={flag(commitments.note)} />
    </aside>
  </div>
</section>

<style>
  .benefits {
    background:
      radial-gradient(50% 60% at 0% 100%, var(--navy-glow), transparent 70%),
      var(--navy);
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: clamp(40px, 5vw, 72px);
  }

  .benefits__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 44px 40px;
  }

  .benefits__list li {
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .benefits__list .tile {
    margin-bottom: 10px;
  }

  .benefits__list h3 {
    font-size: var(--fs-h4);
    line-height: 1.25;
  }

  .commit {
    padding: clamp(28px, 3vw, 40px);
    border-radius: var(--r-lg);
    background: var(--paper);
    color: var(--body);
    box-shadow: var(--shadow-panel);
  }

  .commit h3,
  .commit h4 {
    color: var(--ink);
  }

  .commit ul {
    display: grid;
    gap: 28px;
    margin-top: 32px;
  }

  .commit li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
  }

  .commit li p {
    margin-top: 6px;
    color: var(--muted);
  }

  .commit__note {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .benefits__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 599px) {
    .benefits__list {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .commit li {
      gap: 16px;
    }
  }
</style>
