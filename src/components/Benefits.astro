---
// REVIEW: two stage backgrounds are on the page so one can be chosen. Keep the
// winner, delete the other, the `option` / `duplicate` / `commitments` props and
// the option tag.
//   rails: faint vertical hairlines
//   dots:  faint dot grid
// Rejected earlier, do not bring back: photo behind, rings + guides, app window.
import BenefitVisual from './BenefitVisual.astro';
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { flag, headline } from '../lib/text';

interface Props {
  stage?: 'rails' | 'dots';
  /** Review label. */
  option?: string;
  /** A repeat of the card grid: no section heading. */
  duplicate?: boolean;
  /** Show the commitments panel under the cards. */
  commitments?: boolean;
}

const { stage = 'rails', option, duplicate = false, commitments: showCommitments = true } = Astro.props;
const { benefits } = await getHomepage();
const { commitments } = benefits;
---

<section
  class:list={['section', 'benefits', `benefits--${stage}`, { 'benefits--repeat': duplicate, 'benefits--open': !showCommitments }]}
  data-nav="light"
  aria-labelledby={duplicate ? undefined : 'benefits-title'}
  aria-label={duplicate ? option : undefined}
>
  <div class="wrap">
    {
      !duplicate && (
        <div class="section__head section__head--center">
          <h2 id="benefits-title" set:html={headline(benefits.headline)} />
          <p class="lead" set:html={flag(benefits.sub)} />
        </div>
      )
    }
    {option && <p class="option-tag">{option}</p>}

    <ul role="list" class="benefits__list">
      {
        benefits.items.map((item, index) => (
          <li class="reveal" style={`--i:${index % 2}`}>
            <div class="benefit__visual">
              <BenefitVisual kind={item.visual} />
            </div>
            <div class="benefit__copy">
              <h3>{item.title}</h3>
              <p set:html={flag(item.text)} />
            </div>
          </li>
        ))
      }
    </ul>

    {
      showCommitments && (
        <div class="panel panel--deep commit">
          <div class="commit__copy">
            <h3 id="commit-title">{commitments.title}</h3>
            <p class="commit__note" set:html={flag(commitments.note)} />
          </div>

          <ul role="list" class="inset commit__list reveal" aria-labelledby="commit-title">
            {
              commitments.items.map((item) => (
                <li>
                  <span class="tile">
                    <Icon name={item.icon} />
                  </span>
                  <div>
                    <h4>{item.title}</h4>
                    <p set:html={flag(item.text)} />
                  </div>
                  <span class="tick commit__check">
                    <Icon name="check" size={16} stroke={2.5} />
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  /* Four cards, two by two: a pale stage holding a small coded illustration,
     then the benefit in words. */
  .benefits__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 20px;
  }

  .benefits__list > li {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--card);
  }

  .option-tag {
    margin-bottom: 20px;
  }

  /* Review copies sit close under the one above. */
  .benefits--open {
    padding-bottom: 0;
  }

  .benefits--repeat {
    padding-top: 56px;
  }

  .benefit__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 340px;
    padding: 40px clamp(20px, 4vw, 48px);
    overflow: hidden;
    background: linear-gradient(180deg, var(--tint) 0%, var(--tint-2) 100%);
    isolation: isolate;
  }

  .benefit__visual > :global(.bv) {
    position: relative;
    width: min(100%, 440px);
  }

  .benefit__visual::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* A. Rails: vertical hairlines, fading out at the top and the foot. */
  .benefits--rails .benefit__visual::before {
    background: repeating-linear-gradient(90deg, rgba(20, 52, 110, 0.1) 0 1px, transparent 1px 44px) center / 100% 100%;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 78%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 78%, transparent 100%);
  }

  /* B. Dots: an even dot grid, thinning toward the edges. */
  .benefits--dots .benefit__visual::before {
    background: radial-gradient(circle, rgba(20, 52, 110, 0.24) 1px, rgba(20, 52, 110, 0) 1.6px) center / 22px 22px;
    -webkit-mask-image: radial-gradient(120% 120% at 50% 50%, #000 40%, transparent 100%);
    mask-image: radial-gradient(120% 120% at 50% 50%, #000 40%, transparent 100%);
  }

  .benefit__copy {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 28px clamp(24px, 3vw, 36px) 32px;
  }

  .benefit__copy h3 {
    font-size: var(--fs-h4);
    line-height: 1.25;
  }

  .benefit__copy p {
    max-width: 44ch;
    color: var(--muted);
  }

  .commit {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    padding: clamp(28px, 4vw, 56px);
  }

  .commit__copy {
    display: grid;
    gap: 20px;
  }

  .commit__copy h3 {
    font-size: var(--fs-h2);
    line-height: 1.12;
  }

  .commit__note {
    color: var(--muted);
  }

  .commit__list {
    padding: 8px clamp(20px, 2.4vw, 32px);
  }

  .commit__list li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 20px;
    padding-block: 24px;
    border-top: 1px solid var(--line);
  }

  .commit__list li:first-child {
    border-top: 0;
  }

  .commit__list p {
    margin-top: 6px;
    color: var(--muted);
  }

  .commit__check {
    margin-top: 4px;
  }

  @media (max-width: 1023px) {
    .commit {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .benefits__list {
      grid-template-columns: 1fr;
    }

    .benefit__visual {
      min-height: 260px;
    }
  }

  @media (max-width: 599px) {

    .commit__list li {
      grid-template-columns: auto 1fr;
      gap: 16px;
    }

    .commit__check {
      display: none;
    }
  }
</style>
