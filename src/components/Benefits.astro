---
import BenefitVisual from './BenefitVisual.astro';
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { flag, headline } from '../lib/text';

const { benefits } = await getHomepage();
const { commitments } = benefits;
---

<section class="section benefits" data-nav="light" aria-labelledby="benefits-title">
  <div class="wrap">
    <div class="section__head section__head--center">
      <h2 id="benefits-title" set:html={headline(benefits.headline)} />
      <p class="lead" set:html={flag(benefits.sub)} />
    </div>

    <ul role="list" class="benefits__list">
      {
        benefits.items.map((item, index) => (
          <li class="reveal" style={`--i:${index % 2}`}>
            <div class="benefit__visual">
              <BenefitVisual kind={item.visual} />
            </div>
            <div class="benefit__copy">
              <h3>{item.title}</h3>
              <p set:html={flag(item.text)} />
            </div>
          </li>
        ))
      }
    </ul>

    <div class="panel commit">
      <div class="commit__copy">
        <h3 id="commit-title">{commitments.title}</h3>
        <p class="commit__note" set:html={flag(commitments.note)} />
      </div>

      <ul role="list" class="mock commit__list reveal" aria-labelledby="commit-title">
        {
          commitments.items.map((item) => (
            <li>
              <span class="tile">
                <Icon name={item.icon} />
              </span>
              <div>
                <h4>{item.title}</h4>
                <p set:html={flag(item.text)} />
              </div>
              <span class="tick commit__check">
                <Icon name="check" size={16} stroke={2.5} />
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Four cards, two by two: a pale stage holding a small coded illustration,
     then the benefit in words. */
  .benefits__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 20px;
  }

  .benefits__list > li {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--card);
  }

  .benefit__visual {
    display: grid;
    place-items: center;
    min-height: 300px;
    padding: 36px clamp(20px, 4vw, 48px);
    background: linear-gradient(180deg, var(--tint) 0%, var(--tint-2) 100%);
  }

  .benefit__copy {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 28px clamp(24px, 3vw, 36px) 32px;
  }

  .benefit__copy h3 {
    font-size: var(--fs-h4);
    line-height: 1.25;
  }

  .benefit__copy p {
    max-width: 44ch;
    color: var(--muted);
  }

  .commit {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    padding: clamp(28px, 4vw, 56px);
  }

  .commit__copy {
    display: grid;
    gap: 20px;
  }

  .commit__copy h3 {
    font-size: var(--fs-h2);
    line-height: 1.12;
  }

  .commit__note {
    color: var(--muted);
  }

  .commit__list {
    padding: 8px clamp(20px, 2.4vw, 32px);
  }

  .commit__list li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 20px;
    padding-block: 24px;
    border-top: 1px solid var(--line);
  }

  .commit__list li:first-child {
    border-top: 0;
  }

  .commit__list p {
    margin-top: 6px;
    color: var(--muted);
  }

  .commit__check {
    margin-top: 4px;
  }

  @media (max-width: 1023px) {
    .commit {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .benefits__list {
      grid-template-columns: 1fr;
    }

    .benefit__visual {
      min-height: 260px;
    }
  }

  @media (max-width: 599px) {

    .commit__list li {
      grid-template-columns: auto 1fr;
      gap: 16px;
    }

    .commit__check {
      display: none;
    }
  }
</style>
