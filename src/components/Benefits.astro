---
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { flag, headline } from '../lib/text';

const { benefits } = await getHomepage();
const { commitments } = benefits;
---

<section class="section benefits" data-nav="light" aria-labelledby="benefits-title">
  <div class="wrap">
    <div class="panel benefits__panel">
      <div class="section__head section__head--center">
        <h2 id="benefits-title" set:html={headline(benefits.headline)} />
        <p class="lead" set:html={flag(benefits.sub)} />
      </div>

      <ul role="list" class="benefits__list">
        {
          benefits.items.map((item, index) => (
            <li class="reveal" style={`--i:${index}`}>
              <span class="tile">
                <Icon name={item.icon} />
              </span>
              <h3>{item.title}</h3>
              <p set:html={flag(item.text)} />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="panel panel--rings commit">
      <div class="commit__copy">
        <h3 id="commit-title">{commitments.title}</h3>
        <p class="commit__note" set:html={flag(commitments.note)} />
      </div>

      <ul role="list" class="mock commit__list reveal" aria-labelledby="commit-title">
        {
          commitments.items.map((item) => (
            <li>
              <span class="tile">
                <Icon name={item.icon} />
              </span>
              <div>
                <h4>{item.title}</h4>
                <p set:html={flag(item.text)} />
              </div>
              <Icon name="check" size={22} stroke={2} class="commit__check" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .benefits .wrap {
    display: grid;
    gap: 20px;
  }

  /* A lighter dome at the top of the panel, behind the heading. */
  .benefits__panel {
    padding: clamp(40px, 5vw, 72px) clamp(24px, 3vw, 40px) clamp(24px, 3vw, 40px);
    background:
      radial-gradient(90% 250px at 50% 0%, #ffffff 0%, #ffffff 99.6%, transparent 100%),
      linear-gradient(180deg, var(--tint) 0%, var(--tint-2) 100%);
  }

  .benefits__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .benefits__list li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 28px 24px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.6);
  }

  .benefits__list .tile {
    margin-bottom: 14px;
  }

  .benefits__list h3 {
    font-size: var(--fs-h4);
    line-height: 1.25;
  }

  .benefits__list p {
    color: var(--muted);
  }

  .commit {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    padding: clamp(28px, 4vw, 56px);
  }

  .commit__copy {
    display: grid;
    gap: 20px;
  }

  .commit__copy h3 {
    font-size: var(--fs-h2);
    line-height: 1.12;
  }

  .commit__note {
    color: var(--muted);
  }

  .commit__list {
    padding: 8px clamp(20px, 2.4vw, 32px);
  }

  .commit__list li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 20px;
    padding-block: 24px;
    border-top: 1px solid var(--line);
  }

  .commit__list li:first-child {
    border-top: 0;
  }

  .commit__list p {
    margin-top: 6px;
    color: var(--muted);
  }

  .commit__list :global(.commit__check) {
    margin-top: 4px;
    color: var(--navy);
  }

  @media (max-width: 1099px) {
    .benefits__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 1023px) {
    .commit {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 599px) {
    .benefits__list {
      grid-template-columns: 1fr;
    }

    .commit__list li {
      grid-template-columns: auto 1fr;
      gap: 16px;
    }

    .commit__list :global(.commit__check) {
      display: none;
    }
  }
</style>
