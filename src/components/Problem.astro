---
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { flag, headline } from '../lib/text';

const { problem } = await getHomepage();
---

<section class="section section--tint problem" aria-labelledby="problem-title">
  <div class="wrap problem__grid">
    <div class="problem__head">
      <h2 id="problem-title" set:html={headline(problem.headline)} />
      <p class="lead" set:html={flag(problem.sub)} />
      <p class="problem__turn">
        <Icon name="arrow-narrow-down" size={26} />
        {problem.transition}
      </p>
    </div>

    <ul role="list" class="problem__list">
      {
        problem.items.map((item, index) => (
          <li class="reveal" style={`--i:${index}`}>
            <span class="tile tile--on-white">
              <Icon name={item.icon} />
            </span>
            <div>
              <h3>{item.title}</h3>
              <p set:html={flag(item.text)} />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .problem__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: clamp(40px, 6vw, 96px);
  }

  .problem__head {
    position: sticky;
    top: calc(var(--nav-h) + 56px);
    display: grid;
    gap: 20px;
  }

  .problem__turn {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    color: var(--ink);
    font-weight: 600;
  }

  .problem__turn :global(.icon) {
    flex: none;
    color: var(--gold-ink);
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    padding-block: 28px;
    border-top: 1px solid var(--line);
  }

  li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  li:last-child {
    padding-bottom: 0;
  }

  h3 {
    font-size: var(--fs-h4);
    line-height: 1.25;
  }

  li p {
    margin-top: 8px;
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .problem__grid {
      grid-template-columns: 1fr;
    }

    .problem__head {
      position: static;
    }
  }

  @media (max-width: 479px) {
    li {
      gap: 16px;
    }
  }
</style>
