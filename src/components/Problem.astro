---
import Icon from './Icon.astro';
import Scorecard from './Scorecard.astro';
import { getHomepage } from '../lib/content';
import { flag, headline } from '../lib/text';

const { problem } = await getHomepage();
---

<section class="section problem" data-nav="light" aria-labelledby="problem-title">
  <div class="wrap problem__grid">
    <div>
      <div class="section__head">
        <h2 id="problem-title" set:html={headline(problem.headline)} />
        <p class="lead" set:html={flag(problem.sub)} />
      </div>

      <ul role="list" class="problem__list">
        {
          problem.items.map((item, index) => (
            <li class="reveal" style={`--i:${index}`}>
              <span class="tile">
                <Icon name={item.icon} />
              </span>
              <div>
                <h3>{item.title}</h3>
                <p set:html={flag(item.text)} />
              </div>
            </li>
          ))
        }
      </ul>

      <p class="problem__turn">
        <Icon name="arrow-narrow-right" size={26} />
        {problem.transition}
      </p>
    </div>

    <div class="panel panel--rings problem__visual">
      <Scorecard />
    </div>
  </div>
</section>

<style>
  .problem__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: clamp(40px, 6vw, 96px);
  }

  .problem__visual {
    position: sticky;
    top: calc(var(--nav-h) + 56px);
    padding: clamp(20px, 3vw, 40px) clamp(20px, 3vw, 40px) clamp(16px, 2vw, 24px);
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    padding-block: 28px;
    border-top: 1px solid var(--line);
  }

  li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  h3 {
    font-size: var(--fs-h4);
    line-height: 1.25;
  }

  li p {
    margin-top: 8px;
    color: var(--muted);
  }

  .problem__turn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-weight: var(--fw-medium);
  }

  .problem__turn :global(.icon) {
    flex: none;
  }

  @media (max-width: 1023px) {
    .problem__grid {
      grid-template-columns: 1fr;
    }

    /* relative, not static: the panel's ring texture is positioned against it */
    .problem__visual {
      position: relative;
      top: auto;
    }
  }

  @media (max-width: 479px) {
    li {
      gap: 16px;
    }
  }
</style>
