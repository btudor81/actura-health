---
// Roles and credentials only. Names and photos stay off the public site.
// A ruled list, every role on one row: chosen over two slider layouts (2026-10-12).
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { flag, headline } from '../lib/text';

const { team } = await getHomepage();
---

<section id="team" class="section team" data-nav="light" aria-labelledby="team-title">
  <div class="wrap">
    <div class="section__head">
      <h2 id="team-title" set:html={headline(team.headline)} />
      <p class="lead" set:html={flag(team.sub)} />
    </div>

    <ul role="list" class="roster">
      {
        team.members.map((member, index) => (
          <li class="reveal" style={`--i:${index % 3}`}>
            <span class="tile">
              <Icon name={member.icon} />
            </span>
            <h3>{member.role}</h3>
            <ul role="list" class="creds">
              {member.credentials.map((credential) => (
                <li>
                  <span class="tick">
                    <Icon name="check" size={14} stroke={2.5} />
                  </span>
                  <span set:html={flag(credential)} />
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .roster {
    border-top: 1px solid var(--line);
  }

  /* Role left, credentials right. */
  .roster > li {
    display: grid;
    grid-template-columns: auto minmax(0, 4fr) minmax(0, 7fr);
    align-items: center;
    gap: 16px 24px;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }

  h3 {
    font-size: var(--fs-h4);
    line-height: 1.25;
  }

  .creds {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    color: var(--muted);
    line-height: 1.4;
  }

  .creds li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
  }

  .creds .tick {
    width: 20px;
    height: 20px;
    margin-top: 4px;
  }

  @media (max-width: 899px) {
    .roster > li {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .creds {
      grid-column: 2;
    }
  }
</style>
