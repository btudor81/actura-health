---
// Roles and credentials only. Names and photos stay off the public site.
import Carousel from './Carousel.astro';
import Icon from './Icon.astro';
import { getHomepage } from '../lib/content';
import { flag, headline } from '../lib/text';

const { team } = await getHomepage();
---

<section id="team" class="section team" data-nav="light" aria-labelledby="team-title">
  <div class="wrap">
    <div class="section__head">
      <h2 id="team-title" set:html={headline(team.headline)} />
      <p class="lead" set:html={flag(team.sub)} />
    </div>

    <div class="reveal">
      <Carousel label="Team roles">
        {
          team.members.map((member) => (
            <li class="member">
              <span class="tile">
                <Icon name={member.icon} />
              </span>
              <h3>{member.role}</h3>
              <ul role="list" class="team__creds">
                {member.credentials.map((credential) => (
                  <li>
                    <span class="tick">
                      <Icon name="check" size={14} stroke={2.5} />
                    </span>
                    <span set:html={flag(credential)} />
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </Carousel>
    </div>
  </div>
</section>

<style>
  /* Three roles in view, the rest one arrow away. */
  .member {
    width: calc((100% - 40px) / 3);
    display: grid;
    align-content: start;
    gap: 16px;
    padding: clamp(24px, 2.6vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: linear-gradient(180deg, var(--tint) 0%, var(--tint-2) 100%);
    box-shadow: inset 0 1px 0 #ffffff;
  }

  h3 {
    font-size: var(--fs-h4);
    line-height: 1.25;
  }

  .team__creds {
    display: grid;
    gap: 10px;
    color: var(--muted);
    line-height: 1.4;
  }

  .team__creds li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
  }

  .team__creds .tick {
    width: 20px;
    height: 20px;
    margin-top: 4px;
  }

  @media (max-width: 1023px) {
    .member {
      width: calc((100% - 20px) / 2);
    }
  }

  @media (max-width: 699px) {
    .member {
      width: 86%;
    }
  }
</style>
